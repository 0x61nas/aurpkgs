# Maintainer: Anas Elgarhy <anas.elgarhy.dev@gmail.com>
pkgname=hys
pkgver=0.2.0
pkgrel=1
pkgdesc='Terminal RSS Reader for Digital Minimalists in Zig.'
url='https://github.com/superstarryeyes/hys'
arch=('x86_64')
license=('MIT')
depends=('curl')
makedepends=('zig')
provides=('hys')
conflicts=('hys-git')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('60663a538f211f228c09d174c3c9de0e0570841c03adf5a61ae61dafa7dfeda2')

build() {
    cd "$pkgname-$pkgver"
    zig build -Doptimize=ReleaseSafe
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 -t ${pkgdir}/usr/bin 'zig-out/bin/hys'
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

# vim: ts=4 sw=4 et:
