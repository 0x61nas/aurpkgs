# Maintainer: Anas Elgarhy <anas.elgarhy.dev@gmail.com>
pkgname=archy-slstatus
pkgver=1.0.1
pkgrel=1
pkgdesc='suckless status monitor for archy linux'
url="https://github.com/archy-linux/$pkgname"
arch=('i686' 'x86_64')
license=('MIT')
makedepends=('make' 'gzip')
provides=('archy-slstatus')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('f331c6a0dcb193e40d8b00d7033000a958dd70e2273c6b54adcdb53e47f0344d')

build() {
    cd "$pkgname-$pkgver"
    make -j
    gzip -9 archy-slstatus.1
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 -t ${pkgdir}/usr/bin 'build/archy-slstatus'
    install -Dm644 -t ${pkgdir}/usr/share/man/man1 archy-slstatus.1.gz
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

# vim: ts=4 sw=4 et:
